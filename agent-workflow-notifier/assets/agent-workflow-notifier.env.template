# agent-workflow-notifier: read by ~/.claude/hooks/slack-done.sh.
# The hook greps SLACK_NOTIFIER_* lines and never sources this file, so keep
# one KEY=value per line and comments on their own lines. Any key here can be
# overridden per repo or worktree by the same key in <cwd>/.env.
# Keep this file at mode 600.

# Required. Your Slack user id: the "User ID" line of `slack auth list`.
SLACK_NOTIFIER_USER=U0123456789

# Required. App and team ids printed by `slack app install`, also in
# <project>/.slack/apps.json.
SLACK_NOTIFIER_APP_ID=A0123456789
SLACK_NOTIFIER_TEAM_ID=T0123456789

# Slack CLI project that owns the app (holds .slack/apps.json). Default shown.
SLACK_NOTIFIER_PROJECT=~/.claude/agent-workflow-notifier

# Optional. Post to a channel id instead of a DM; you are still @-mentioned.
#SLACK_NOTIFIER_CHANNEL=C0123456789

# Optional. Bot token (xoxb-...). When set, the hook posts with curl and never
# touches the Slack CLI or the token cache.
#SLACK_NOTIFIER_TOKEN=xoxb-...

# Optional. Where the hook caches the bot token it fetches. Default shown.
# Delete the file to force a refetch.
#SLACK_NOTIFIER_TOKEN_FILE=~/.claude/agent-workflow-notifier.token

# Optional. Seconds that must pass before a send: since your last prompt for a
# Stop, since the last user entry for a SubagentStop. Permission prompts and
# questions ignore it. Default 120; 0 turns both clocks off.
#SLACK_NOTIFIER_MIN_SECONDS=120

# Optional. Background task types that hold a Stop while one is running or
# pending, comma separated. Default shown; adding shell also holds on background
# commands, including a dev server.
#SLACK_NOTIFIER_HOLD_TYPES=subagent,workflow

# Optional. Where the hook keeps its per-session state. Default shown.
#SLACK_NOTIFIER_STATE_DIR=~/.claude/hooks/slack-done.state

# Optional. Summary bullets on Stop and SubagentStop. claude runs a headless
# `claude -p` over the turn; off uses the first sentence of the final message.
#SLACK_NOTIFIER_SUMMARY=claude

# Optional. Model that writes those bullets. Default shown.
#SLACK_NOTIFIER_SUMMARY_MODEL=haiku

# Optional. Seconds the summarizer may take before the hook falls back. Default shown.
#SLACK_NOTIFIER_SUMMARY_TIMEOUT=45

# Optional. Path to the claude CLI when it is not on PATH, /opt/homebrew/bin,
# /usr/local/bin, ~/.local/bin, or ~/.claude/local.
#SLACK_NOTIFIER_CLAUDE=/opt/homebrew/bin/claude

# Optional. Only notify for these hook events, comma separated.
#SLACK_NOTIFIER_EVENTS=Stop,Notification,PreToolUse

# Optional. Path to the slack CLI when it is not on PATH, ~/.local/bin, or ~/.slack/bin.
#SLACK_NOTIFIER_CLI=/usr/local/bin/slack
